{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Konado Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/../../"
			],
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"preLaunchTask": "pnpm: compile"
		}
	]
}
